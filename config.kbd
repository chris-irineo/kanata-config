(defcfg process-unmapped-keys yes)

(defvar
  tap-timeout 150
  hold-timeout 300
  short-hold-timeout 150
  chord-timeout 100
)

(defalias
  ;; ── Thumbs: tap / hold ────────────────────────────────────────────
  ;; lalt, spc and ralt hold REAL OS-level modifiers (emitted keycodes),
  ;; so every combination composes at the OS level — no combo layers.
  ;; Window-management binds live in Omarchy (~/.config/hypr/bindings.lua).
  ;; Variant policy (do not "fix" into one variant — see CLAUDE.md):
  ;;   spc = tap-hold-release: typing-safe. Space is rolled into the next
  ;;   letter constantly; release-commit means a natural roll (space up
  ;;   first) stays a tap. Press-commit closed windows (SUPER+W!).
  ;;   lalt/ralt/rctl = tap-hold-press: chords fire at the second keypress
  ;;   (d+f → tab), so the modifier must already be committed — a release-
  ;;   commit would land after the chord output.
  ;; lalt's hold also holds the thin ctl layer (mirrors ralt's sft layer):
  ;;   it swaps WHICH real modifier spc emits (lsft, not lmet) — still pure
  ;;   emission, not a C-/M- remap layer. lalt-first + spc = Ctrl+Shift (the
  ;;   app-shortcut grammar, laptop-safe pair); spc-first + lalt = Ctrl+Super,
  ;;   kept for the Omarchy panel/menu grammar. Thumb-roll order picks which.
  lalt (tap-hold-press $tap-timeout $hold-timeout C-bspc (multi lctl (layer-while-held ctl)))
  spc  (tap-hold-release $tap-timeout $hold-timeout spc lmet)
  ralt (tap-hold-press $tap-timeout $short-hold-timeout ret (multi lsft (layer-while-held sft)))
  rctl (tap-hold-press $tap-timeout $hold-timeout esc (layer-while-held num))

  ;; ── The one chord: d+f = Tab ──────────────────────────────────────
  ;; Thumb holds supply modifiers: lalt+d+f = C-tab, lalt+spc+d+f = C-S-tab,
  ;; spc+ralt+d+f = C-M-S-tab, etc. Works from every layer (thin layers
  ;; fall through to base).
  d (chord base_chords d)
  f (chord base_chords f)

  ;; Layer thumbs — laltsft uses press (its hold must be committed before
  ;; chord outputs; it only exists while ralt is deliberately held);
  ;; spcctl uses release for the same typing-safety as @spc (space rolls
  ;; stay taps; it only exists while lalt is deliberately held).
  laltnum (layer-while-held sym)
  laltsft (tap-hold-press $tap-timeout $short-hold-timeout bspc lctl)
  spcctl  (tap-hold-release $tap-timeout $hold-timeout spc lsft)
)

(defchords base_chords $chord-timeout
  (d) d
  (f) f
  (d f) tab
)

;; Three rows + thumbs. The physical digit row is not mapped: digits type
;; via the num layer (rctl), and passthrough keys still pick up the emitted
;; modifiers (spc+6 → SUPER+6 workspace, etc.).
(defsrc
  q        w        e        r        t        y        u        i        o        p
  a        s        d        f        g        h        j        k        l        ;        '
  z        x        c        v        b        n        m        ,        .        /
                              lalt     spc      ralt     rctl
)

(deflayer base
  _        _        _        _        _        _        _        _        _        _
  _        _        @d       @f       _        _        _        _        _        _        _
  _        _        _        _        _        _        _        _        _        _
                              @lalt    @spc     @ralt    @rctl
)

;; Shift — thin layer: only lalt differs (tap = plain bspc; hold = Ctrl, so
;; lalt+ralt covers Ctrl+Shift). Everything else falls through to base and
;; picks up the real Shift automatically.
(deflayer sft
  _        _        _        _        _        _        _        _        _        _
  _        _        _        _        _        _        _        _        _        _        _
  _        _        _        _        _        _        _        _        _        _
                              @laltsft _        _        _
)

;; Ctrl (lalt held) — thin layer: only spc differs (hold = Shift, not
;; Super), so lalt-first + spc = Ctrl+Shift. spc-first + lalt stays
;; Ctrl+Super: kanata locks a key's action at press, so the roll order
;; picks the namespace.
(deflayer ctl
  _        _        _        _        _        _        _        _        _        _
  _        _        _        _        _        _        _        _        _        _        _
  _        _        _        _        _        _        _        _        _        _
                              _        @spcctl  _        _
)

;; Num (rctl) — digits + one-hand editing pad. hjkl = vim arrows; y/o
;; (same columns, one row up) = word jumps — C-left/right double as
;; browser back/forward; u = undo, i = redo, p = paste (C-S-v, the
;; system's paste grammar); the bottom strip deletes word← char← char→
;; word→ (n m , .). Hold ralt too and any motion SELECTS instead
;; (ralt+rctl blocks nothing on the laptop matrix). Hold lalt (rctl
;; first) for the sym layer.
(deflayer num
  /        S-8      -        S-=      =        C-left   C-z      C-S-z    C-right  C-S-v
  1        2        3        4        5        left     down     up       right    _        _
  6        7        8        9        0        C-bspc   bspc     del      C-del    _
                              @laltnum _        _        _
)

;; Sym (rctl, then lalt) — see sym-layer-cheatsheet.txt. Getreuer
;; structure kept: shifted digits in digit order (a..g, z..b), bracket
;; pairs adjacent ([ ] { } on e r t y). Fixes: , . stay at their base
;; keys and the bottom strip m , . / reads / , . ? (? = shift of the
;; / key); l = " completes the home-row run - = + " : '. One symbol
;; per key, no duplicates; plain ; and ' echo their base positions.
(deflayer sym
  S-grv    grv      [        ]        S-[      S-]      S-\      \        S-,      S-.
  S-1      S-2      S-3      S-4      S-5      -        =        S-=      S-'      S-;      '
  S-6      S-7      S-8      S-9      S-0      S--      /        ,        .        S-/
                              _        _        _        _
)
