[Unit]
Description=Kanata layer overlay watcher (kanata TCP -> Omarchy shell)
Documentation=file://%h/.config/kanata/README.md
After=kanata.service wayland-session-waitenv.service graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=OMARCHY_PATH

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/kanata/tools/layer-overlay.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
